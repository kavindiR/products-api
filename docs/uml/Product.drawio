  <diagram id="0jiftleHPc77Bw7JnS23" name="Page-2">
    <mxGraphModel dx="1880" dy="1627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml CoolUni_EERD\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 70\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\n\n&#39; ==================== STYLES ====================\nskinparam class {\n    BackgroundColor #DBEAFE\n    BorderColor #1E40AF\n    ArrowColor #1E3A8A\n    FontColor #000000\n}\n\nskinparam classAttributeIconSize 0\n\n&#39; ==================== ENTITIES ====================\nclass \&quot;COURSE\&quot; as COURSE &lt;&lt;entity&gt;&gt; {\n  + CourseID : {PK}\n  --\n  CourseName\n}\n\nclass \&quot;MODULE\&quot; as MODULE &lt;&lt;entity&gt;&gt; {\n  + ModuleID : {PK}\n  --\n  ModuleName\n}\n\nclass \&quot;STUDENT\&quot; as STUDENT &lt;&lt;entity&gt;&gt; {\n  + StudentID : {PK}\n  --\n  Name\n}\n\nclass \&quot;ACADEMIC STAFF\&quot; as STAFF &lt;&lt;entity&gt;&gt; {\n  + StaffID : {PK}\n  --\n  Name\n}\n\nclass \&quot;TEXTBOOK\&quot; as TEXTBOOK &lt;&lt;entity&gt;&gt; {\n  + TextbookID : {PK}\n  --\n  Title\n}\n\n&#39; ==================== SUBTYPES ====================\nclass \&quot;FULL-TIME LECTURER\&quot; as FT &lt;&lt;subtype&gt;&gt; {\n  + StaffID : {PK, FK}\n  --\n  (specific attributes)\n}\n\nclass \&quot;VISITING LECTURER\&quot; as VL &lt;&lt;subtype&gt;&gt; {\n  + StaffID : {PK, FK}\n  --\n  (specific attributes)\n}\n\n&#39; ==================== TERNARY ASSOCIATION CLASS ====================\nclass \&quot;recommends\&quot; as RECOMMENDS &lt;&lt;ternary&gt;&gt; {\n  + StaffID : {FK}\n  + ModuleID : {FK}\n  + TextbookID : {FK}\n}\n\n&#39; ==================== BINARY RELATIONSHIPS ====================\n\n&#39; Student registers_on Course (M:1)\nSTUDENT \&quot;M\&quot; -- \&quot;1\&quot; COURSE : registers_on &gt;\n\n&#39; Student takes Module (M:N)\nSTUDENT \&quot;M\&quot; -- \&quot;M\&quot; MODULE : takes &gt;\n\n&#39; Module belongs_to Course (M:N)\nMODULE \&quot;M\&quot; -- \&quot;M\&quot; COURSE : belongs_to &gt;\n\n&#39; AcademicStaff delivers Module (M:N)\nSTAFF \&quot;M\&quot; -- \&quot;M\&quot; MODULE : delivers &gt;\n\n&#39; AcademicStaff leads_course Course (1:1, max 1 course)\nSTAFF \&quot;1\&quot; -- \&quot;1\&quot; COURSE : leads_course &gt;\n\n&#39; AcademicStaff leads_module Module (1:M)\nSTAFF \&quot;1\&quot; -- \&quot;M\&quot; MODULE : leads_module &gt;\n\n&#39; ==================== RECURSIVE RELATIONSHIP ====================\n&#39; AcademicStaff mentors AcademicStaff (1:M)\nSTAFF \&quot;1\&quot; -- \&quot;M\&quot; STAFF : mentors &gt;\n\n&#39; ==================== TERNARY RELATIONSHIP ====================\nSTAFF \&quot;M\&quot; -- RECOMMENDS\nMODULE \&quot;M\&quot; -- RECOMMENDS\nTEXTBOOK \&quot;M\&quot; -- RECOMMENDS\n\n&#39; ==================== SPECIALISATION ====================\n&#39; Disjoint, Total specialisation of AcademicStaff\nSTAFF &lt;|-- FT\nSTAFF &lt;|-- VL\n\nnote bottom of STAFF\n  **Specialisation Constraint:**\n  {disjoint, total}\n  Every AcademicStaff member is EITHER\n  a FullTimeLecturer OR a VisitingLecturer.\nend note\n\n&#39; ==================== STYLES FOR SUBTYPES ====================\nskinparam class&lt;&lt;subtype&gt;&gt; {\n    BackgroundColor #DCFCE7\n    BorderColor #166534\n}\n\nskinparam class&lt;&lt;ternary&gt;&gt; {\n    BackgroundColor #FEF9C3\n    BorderColor #A16207\n}\n\nskinparam class&lt;&lt;entity&gt;&gt; {\n    BackgroundColor #DBEAFE\n    BorderColor #1E40AF\n}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OAPRySuc_C7KZm4Mo_An-2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="«entity»&#xa;COURSE" plantUmlId="cls_2" plantUmlBaseStyle="swimlane;collapsible=0;fontStyle=0;align=center;fontSize=12;fontColor=#000000;startSize=47;spacingLeft=25;fillColor=#DBEAFE;strokeColor=#1E40AF;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;marginBottom=0;stackSpacing=0;marginTop=5.5;fontFamily=Arial;swimlaneFillColor=#DBEAFE;" plantUmlBaseValue="«entity»&#xa;COURSE" id="OAPRySuc_C7KZm4Mo_An-3">
